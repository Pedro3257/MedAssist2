# Copie este arquivo para .env e substitua somente os valores necessários.
# Nunca versione o arquivo .env nem use uma senha real neste exemplo.

# PostgreSQL e pgvector executados pelo Docker Compose.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=medassist
POSTGRES_USER=medassist
POSTGRES_PASSWORD=change-me-local-only

# Provider principal: ollama para execução local ou google_ai para execução remota.
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=0.5
LLM_RETRY_BACKOFF=2.0

# Ollama local: o modelo-base e distribuido pelo proprio Ollama e permite
# executar o projeto sem o adapter QLoRA, que e um artefato opcional.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=300
OLLAMA_LANGUAGE_REWRITE_MODEL=gemma3:4b

# Google AI: deixe a chave vazia quando o provider remoto não for utilizado.
GEMINI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash
GOOGLE_AI_LANGUAGE_REWRITE_MODEL=gemini-3.6-flash

# Integrações reais permanecem desativadas por padrão para evitar custo e tráfego.
RUN_OLLAMA_INTEGRATION=0
RUN_RAG_INTEGRATION=0
RUN_GOOGLE_AI_INTEGRATION=0
